import { useState } from 'react';
import { FiGrid, FiCheck, FiAlertCircle, FiCamera, FiImage } from 'react-icons/fi';
import { qrAPI } from '../utils/api';
import toast from 'react-hot-toast';

const QRScanner = () => {
  const [scanResult, setScanResult] = useState(null);
  const [loading, setLoading] = useState(false);
  const [manualCode, setManualCode] = useState('');
  const [scanMode, setScanMode] = useState('manual'); // 'manual' | 'camera' | 'payment'

  // Sample Mathina FreshHub Payment QR Code Data
  const PAYMENT_QR_DATA = {
    upi: 'mathinafresh@paytm',
    name: 'Mathina FreshHub',
    note: 'Payment for chicken products',
    qrCode: `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=upi://pay?pa=mathinafresh@paytm&pn=MathinaFreshHub&cu=INR`,
  };

  // Sample product QR codes for demo
  const SAMPLE_QR_CODES = [
    { code: 'CLUCKFRESH-CHK001-20240115', label: 'Chicken Biryani Cut' },
    { code: 'CLUCKFRESH-CHK002-20240116', label: 'Chicken Lollipop' },
    { code: 'CLUCKFRESH-CHK003-20240117', label: 'Chicken Cube Cut' },
  ];

  const handleScan = async () => {
    if (!manualCode.trim()) {
      toast.error('Please enter a QR code');
      return;
    }

    setLoading(true);
    try {
      const { data } = await qrAPI.scan(manualCode);
      setScanResult(data.data);
      toast.success('QR code scanned successfully!');
      setScanMode('result');
    } catch (error) {
      toast.error('Invalid QR code or product not found');
    } finally {
      setLoading(false);
    }
  };

  const handleSampleScan = (code) => {
    setManualCode(code);
    toast.success(`Selected: ${code}`);
  };

  const handlePaymentQR = () => {
    setScanMode('payment');
  };

  const resetScan = () => {
    setScanResult(null);
    setManualCode('');
    setScanMode('manual');
  };

  return (
    <div className="min-h-screen bg-gray-50 py-8 px-4 sm:px-6 lg:px-8">
      <div className="max-w-4xl mx-auto">
        <h1 className="text-3xl font-bold text-center mb-4">Product Traceability</h1>
        <p className="text-center text-gray-600 mb-8">
          Scan QR Code from your product packaging to view its journey from farm to table
        </p>

        {/* Mode Selection Tabs */}
        <div className="flex bg-white rounded-xl shadow-md p-1 mb-6 overflow-x-auto">
          <button
            onClick={() => setScanMode('manual')}
            className={`flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
              scanMode === 'manual' || scanMode === 'result'
                ? 'bg-primary-100 text-primary-700 shadow-sm'
                : 'text-gray-500 hover:text-gray-700'
            }`}
          >
            <FiGrid className="w-4 h-4" />
            Manual Entry
          </button>
          <button
            onClick={() => setScanMode('camera')}
            className={`flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
              scanMode === 'camera'
                ? 'bg-primary-100 text-primary-700 shadow-sm'
                : 'text-gray-500 hover:text-gray-700'
            }`}
          >
            <FiCamera className="w-4 h-4" />
            Camera Scan
          </button>
          <button
            onClick={handlePaymentQR}
            className={`flex-1 flex items-center justify-center gap-2 py-3 px-4 rounded-lg text-sm font-semibold transition-all whitespace-nowrap ${
              scanMode === 'payment'
                ? 'bg-purple-100 text-purple-700 shadow-sm'
                : 'text-gray-500 hover:text-gray-700'
            }`}
          >
            <FiImage className="w-4 h-4" />
            Payment QR
          </button>
        </div>

        {/* Manual Entry & Result View */}
        {(scanMode === 'manual' || scanMode === 'result') && !scanResult && (
          <div className="bg-white rounded-xl shadow-md p-8 mb-8">
            <div className="text-center mb-6">
              <FiGrid className="w-16 h-16 mx-auto text-primary-600 mb-4" />
              <h2 className="text-xl font-bold mb-2">Enter QR Code</h2>
              <p className="text-gray-600">
                Type the QR code from your product packaging
              </p>
            </div>

            <div className="space-y-4">
              <div>
                <label className="block text-sm font-medium text-gray-700 mb-2">
                  QR Code
                </label>
                <input
                  type="text"
                  value={manualCode}
                  onChange={(e) => setManualCode(e.target.value)}
                  placeholder="CLUCKFRESH-XXXXX-XXXXX"
                  className="input-field text-center text-lg font-mono"
                />
              </div>

              <button
                onClick={handleScan}
                disabled={loading}
                className="w-full btn-primary flex items-center justify-center space-x-2"
              >
                <FiGrid />
                <span>{loading ? 'Scanning...' : 'Scan QR Code'}</span>
              </button>

              {/* Sample QR Codes */}
              <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                <h3 className="font-semibold text-blue-900 mb-3 flex items-center gap-2">
                  <FiAlertCircle className="w-5 h-5" />
                  Try Sample QR Codes
                </h3>
                <div className="space-y-2">
                  {SAMPLE_QR_CODES.map((sample, idx) => (
                    <button
                      key={idx}
                      onClick={() => handleSampleScan(sample.code)}
                      className="w-full flex items-center justify-between bg-white rounded-lg p-3 hover:bg-blue-100 transition-colors border border-blue-200"
                    >
                      <div className="text-left">
                        <div className="font-mono text-sm font-bold text-blue-900">{sample.code}</div>
                        <div className="text-xs text-blue-700">{sample.label}</div>
                      </div>
                      <FiGrid className="text-blue-600" />
                    </button>
                  ))}
                </div>
              </div>

              <div className="bg-gray-50 border border-gray-200 rounded-lg p-4">
                <h3 className="font-semibold text-gray-900 mb-2">ℹ️ How to find QR Code</h3>
                <p className="text-sm text-gray-700">
                  The QR code is printed on your product packaging. It starts with "CLUCKFRESH"
                  followed by product ID and timestamp.
                </p>
              </div>
            </div>
          </div>
        )}

        {/* Camera Scan Simulation */}
        {scanMode === 'camera' && (
          <div className="bg-white rounded-xl shadow-md p-8 mb-8">
            <div className="text-center mb-6">
              <FiCamera className="w-16 h-16 mx-auto text-primary-600 mb-4" />
              <h2 className="text-xl font-bold mb-2">Camera Scanner</h2>
              <p className="text-gray-600">
                Point your camera at the QR code on product packaging
              </p>
            </div>

            {/* Camera Viewfinder Simulation */}
            <div className="relative bg-gray-900 rounded-2xl overflow-hidden mb-6 aspect-square max-w-md mx-auto">
              <div className="absolute inset-0 flex items-center justify-center">
                <div className="text-center text-white">
                  <FiCamera className="w-20 h-20 mx-auto mb-4 opacity-50" />
                  <p className="text-sm opacity-70">Camera preview would appear here</p>
                  <p className="text-xs opacity-50 mt-2">Requires camera permission</p>
                </div>
              </div>
              
              {/* Scanner Frame Overlay */}
              <div className="absolute inset-8 border-4 border-white/30 rounded-2xl">
                <div className="absolute top-0 left-0 w-8 h-8 border-t-4 border-l-4 border-primary-500 rounded-tl-2xl"></div>
                <div className="absolute top-0 right-0 w-8 h-8 border-t-4 border-r-4 border-primary-500 rounded-tr-2xl"></div>
                <div className="absolute bottom-0 left-0 w-8 h-8 border-b-4 border-l-4 border-primary-500 rounded-bl-2xl"></div>
                <div className="absolute bottom-0 right-0 w-8 h-8 border-b-4 border-r-4 border-primary-500 rounded-br-2xl"></div>
              </div>

              {/* Scanning Animation */}
              <div className="absolute left-8 right-8 h-0.5 bg-gradient-to-r from-transparent via-primary-500 to-transparent animate-pulse"></div>
            </div>

            {/* Quick Sample Codes */}
            <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
              <h3 className="font-semibold text-blue-900 mb-3">📱 Quick Scan Samples</h3>
              <p className="text-sm text-blue-700 mb-3">Click to simulate scanning:</p>
              <div className="grid grid-cols-1 sm:grid-cols-3 gap-2">
                {SAMPLE_QR_CODES.map((sample, idx) => (
                  <button
                    key={idx}
                    onClick={() => handleSampleScan(sample.code)}
                    className="bg-white rounded-lg p-3 hover:bg-blue-100 transition-colors border border-blue-200 text-center"
                  >
                    <div className="font-mono text-xs font-bold text-blue-900 truncate">{sample.code}</div>
                    <div className="text-xs text-blue-700 mt-1">{sample.label}</div>
                  </button>
                ))}
              </div>
            </div>

            <div className="mt-4 bg-gray-50 border border-gray-200 rounded-lg p-4 text-center">
              <p className="text-sm text-gray-700">
                📷 <strong>Camera access</strong> requires browser permission. For demo, use sample codes above.
              </p>
            </div>
          </div>
        )}

        {/* Payment QR Code Section */}
        {scanMode === 'payment' && (
          <div className="bg-white rounded-xl shadow-md p-8 mb-8">
            <div className="text-center mb-6">
              <div className="inline-flex items-center justify-center w-20 h-20 bg-purple-100 rounded-full mb-4">
                <FiImage className="w-10 h-10 text-purple-600" />
              </div>
              <h2 className="text-2xl font-bold mb-2">Mathina FreshHub Payment</h2>
              <p className="text-gray-600">
                Scan to pay via UPI - Quick, Safe & Secure
              </p>
            </div>

            {/* Payment QR Code */}
            <div className="max-w-sm mx-auto mb-6">
              <div className="bg-gradient-to-br from-purple-500 to-purple-700 p-6 rounded-3xl shadow-xl">
                <div className="bg-white rounded-2xl p-6 mb-4">
                  <img
                    src={PAYMENT_QR_DATA.qrCode}
                    alt="Payment QR Code"
                    className="w-full h-auto rounded-lg"
                    onError={(e) => {
                      e.target.src = `https://api.qrserver.com/v1/create-qr-code/?size=300x300&data=upi://pay?pa=mathinafresh@paytm&pn=MathinaFreshHub&cu=INR`;
                    }}
                  />
                </div>
                <div className="text-center text-white">
                  <div className="text-sm opacity-90 mb-1">Pay to</div>
                  <div className="text-xl font-bold mb-2">{PAYMENT_QR_DATA.name}</div>
                  <div className="text-sm opacity-75 font-mono">{PAYMENT_QR_DATA.upi}</div>
                </div>
              </div>
            </div>

            {/* Payment Details */}
            <div className="grid md:grid-cols-3 gap-4 mb-6">
              <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 text-center">
                <div className="text-2xl mb-2">💳</div>
                <div className="font-semibold text-purple-900">UPI Payment</div>
                <div className="text-sm text-purple-700">Any UPI App</div>
              </div>
              <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 text-center">
                <div className="text-2xl mb-2">⚡</div>
                <div className="font-semibold text-purple-900">Instant</div>
                <div className="text-sm text-purple-700">Real-time</div>
              </div>
              <div className="bg-purple-50 border border-purple-200 rounded-lg p-4 text-center">
                <div className="text-2xl mb-2">🔒</div>
                <div className="font-semibold text-purple-900">Secure</div>
                <div className="text-sm text-purple-700">100% Safe</div>
              </div>
            </div>

            {/* How to Pay */}
            <div className="bg-gray-50 border border-gray-200 rounded-lg p-6">
              <h3 className="font-bold text-gray-900 mb-4 flex items-center gap-2">
                <FiAlertCircle className="w-5 h-5" />
                How to Pay using QR Code
              </h3>
              <div className="grid md:grid-cols-4 gap-4">
                {[
                  { step: 1, icon: '📱', title: 'Open UPI App', desc: 'GPay, PhonePe, Paytm, etc.' },
                  { step: 2, icon: '📷', title: 'Scan QR Code', desc: 'Point camera at QR code' },
                  { step: 3, icon: '💰', title: 'Enter Amount', desc: 'Type payment amount' },
                  { step: 4, icon: '✅', title: 'Confirm Payment', desc: 'Enter UPI PIN' },
                ].map((item) => (
                  <div key={item.step} className="text-center">
                    <div className="w-12 h-12 bg-purple-100 rounded-full flex items-center justify-center text-2xl mx-auto mb-2">
                      {item.icon}
                    </div>
                    <div className="font-semibold text-gray-900 text-sm mb-1">{item.title}</div>
                    <div className="text-xs text-gray-600">{item.desc}</div>
                  </div>
                ))}
              </div>
            </div>

            {/* Supported Apps */}
            <div className="mt-6 text-center">
              <p className="text-sm text-gray-600 mb-3">Supported UPI Apps:</p>
              <div className="flex flex-wrap justify-center gap-3">
                {['Google Pay', 'PhonePe', 'Paytm', 'BHIM', 'Amazon Pay', 'WhatsApp Pay'].map((app) => (
                  <span key={app} className="bg-gray-100 text-gray-700 px-4 py-2 rounded-full text-xs font-medium">
                    {app}
                  </span>
                ))}
              </div>
            </div>

            {/* Back Button */}
            <button
              onClick={() => setScanMode('manual')}
              className="w-full mt-6 btn-outline"
            >
              Back to Scanner
            </button>
          </div>
        )}

        {/* Scan Result View */}
        {scanResult && (
            <div className="space-y-6">
              {/* Success Header */}
              <div className="text-center">
                <FiCheck className="w-16 h-16 mx-auto text-green-600 mb-4" />
                <h3 className="text-2xl font-bold text-gray-900">Product Verified!</h3>
              </div>

              {/* Product Info */}
              {scanResult.product && (
                <div className="bg-gray-50 rounded-lg p-6">
                  <h4 className="font-bold text-lg mb-4">Product Information</h4>
                  <div className="space-y-2">
                    <div className="flex justify-between">
                      <span className="text-gray-600">Product Name:</span>
                      <span className="font-medium">{scanResult.product.name}</span>
                    </div>
                    <div className="flex justify-between">
                      <span className="text-gray-600">Category:</span>
                      <span className="font-medium capitalize">{scanResult.product.category}</span>
                    </div>
                    {scanResult.product.price && (
                      <div className="flex justify-between">
                        <span className="text-gray-600">Price:</span>
                        <span className="font-medium">₹{scanResult.product.price}</span>
                      </div>
                    )}
                  </div>
                </div>
              )}

              {/* Traceability Info */}
              {scanResult.traceabilityData && (
                <div className="space-y-4">
                  <h4 className="font-bold text-lg">Farm to Table Journey</h4>

                  {/* Farm Origin */}
                  {scanResult.traceabilityData.farmName && (
                    <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                      <h5 className="font-semibold text-green-900 mb-2">🏡 Farm Origin</h5>
                      <p className="text-green-800">{scanResult.traceabilityData.farmName}</p>
                      <p className="text-green-700 text-sm">
                        {scanResult.traceabilityData.farmLocation}
                      </p>
                    </div>
                  )}

                  {/* Processing Date */}
                  {scanResult.traceabilityData.processingDate && (
                    <div className="bg-blue-50 border border-blue-200 rounded-lg p-4">
                      <h5 className="font-semibold text-blue-900 mb-2">📅 Processing Date</h5>
                      <p className="text-blue-800">
                        {new Date(scanResult.traceabilityData.processingDate).toLocaleDateString(
                          'en-IN',
                          {
                            day: 'numeric',
                            month: 'long',
                            year: 'numeric',
                          }
                        )}
                      </p>
                    </div>
                  )}

                  {/* Quality Checks */}
                  <div className="grid grid-cols-2 gap-4">
                    {scanResult.traceabilityData.halalCertified && (
                      <div className="bg-amber-50 border border-amber-200 rounded-lg p-3 text-center">
                        <div className="text-2xl mb-1">☪️</div>
                        <div className="text-sm font-semibold text-amber-900">Halal Certified</div>
                      </div>
                    )}
                    {scanResult.traceabilityData.organicCertified && (
                      <div className="bg-green-50 border border-green-200 rounded-lg p-3 text-center">
                        <div className="text-2xl mb-1">🌿</div>
                        <div className="text-sm font-semibold text-green-900">Organic</div>
                      </div>
                    )}
                    {scanResult.traceabilityData.antibioticFree && (
                      <div className="bg-blue-50 border border-blue-200 rounded-lg p-3 text-center">
                        <div className="text-2xl mb-1">💉</div>
                        <div className="text-sm font-semibold text-blue-900">
                          Antibiotic-Free
                        </div>
                      </div>
                    )}
                  </div>

                  {/* Vaccination Details */}
                  {scanResult.traceabilityData.vaccinationDetails?.vaccinated && (
                    <div className="bg-purple-50 border border-purple-200 rounded-lg p-4">
                      <h5 className="font-semibold text-purple-900 mb-2">💉 Vaccination</h5>
                      <p className="text-purple-800 text-sm">
                        Vaccinated: Yes
                        {scanResult.traceabilityData.vaccinationDetails.lastVaccinationDate && (
                          <span>
                            {' '}
                            on{' '}
                            {new Date(
                              scanResult.traceabilityData.vaccinationDetails.lastVaccinationDate
                            ).toLocaleDateString('en-IN')}
                          </span>
                        )}
                      </p>
                    </div>
                  )}

                  {/* Quality Check */}
                  {scanResult.traceabilityData.qualityCheck?.passed && (
                    <div className="bg-green-50 border border-green-200 rounded-lg p-4">
                      <h5 className="font-semibold text-green-900 mb-2">✅ Quality Check</h5>
                      <p className="text-green-800 text-sm">
                        Passed by {scanResult.traceabilityData.qualityCheck.checkedBy}
                      </p>
                      <p className="text-green-700 text-sm">
                        {new Date(scanResult.traceabilityData.qualityCheck.checkedAt).toLocaleString(
                          'en-IN'
                        )}
                      </p>
                    </div>
                  )}
                </div>
              )}

              {/* Scan Stats */}
              <div className="text-center text-sm text-gray-600">
                <p>This QR code has been scanned {scanResult.scanCount} times</p>
                <p className="text-xs mt-1">
                  First scanned:{' '}
                  {new Date(scanResult.firstScannedAt).toLocaleDateString('en-IN')}
                </p>
              </div>

              <button onClick={resetScan} className="w-full btn-outline">
                Scan Another Product
              </button>
            </div>
          )}
        </div>
      )}

      {/* Info Section */}
      <div className="bg-gradient-to-r from-primary-600 to-primary-700 rounded-xl shadow-md p-8 text-white">
          <h3 className="text-xl font-bold mb-4">🔍 Why Scan QR Codes?</h3>
          <div className="grid md:grid-cols-3 gap-6">
            <div>
              <div className="text-3xl mb-2">🏡</div>
              <h4 className="font-semibold mb-1">Farm Transparency</h4>
              <p className="text-sm text-primary-100">
                Know exactly which farm your chicken came from
              </p>
            </div>
            <div>
              <div className="text-3xl mb-2">✅</div>
              <h4 className="font-semibold mb-1">Quality Assured</h4>
              <p className="text-sm text-primary-100">
                Verify quality checks and certifications
              </p>
            </div>
            <div>
              <div className="text-3xl mb-2">📅</div>
              <h4 className="font-semibold mb-1">Freshness Guarantee</h4>
              <p className="text-sm text-primary-100">
                Check processing date for maximum freshness
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  );
};

export default QRScanner;
